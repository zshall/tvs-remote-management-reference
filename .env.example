# Key supplied by TVS when connecting to the SSE or JSON endpoint.
TVS_REMOTE_MANAGEMENT_CLIENT_KEY=replace-with-a-secret

# Key supplied by the control panel or other command-sending clients.
TVS_REMOTE_MANAGEMENT_CONTROL_KEY=replace-with-a-secret

# Optional. The local-only default is 127.0.0.1.
# TVS_REMOTE_MANAGEMENT_HOST=0.0.0.0
